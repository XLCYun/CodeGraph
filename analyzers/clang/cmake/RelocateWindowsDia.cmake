# LLVM 21.1.8 的 Windows 包把构建机 DIA 库绝对路径导出在 LLVMDebugInfoPDB 上。
# 来源：https://github.com/llvm/llvm-project/blob/llvmorg-21.1.8/llvm/lib/DebugInfo/PDB/CMakeLists.txt
# 只修改当前配置中的导入目标，不修改固定 SDK 的任何文件。
function(codegraph_relocate_windows_dia visual_studio_root)
  if("${visual_studio_root}" STREQUAL "")
    message(FATAL_ERROR "A fixed CMAKE_GENERATOR_INSTANCE is required for the VS2022 DIA library")
  endif()
  string(REPLACE "\\" "/" _codegraph_vs_root "${visual_studio_root}")
  set(_codegraph_dia "${_codegraph_vs_root}/DIA SDK/lib/amd64/diaguids.lib")
  if(NOT EXISTS "${_codegraph_dia}" OR IS_DIRECTORY "${_codegraph_dia}")
    message(FATAL_ERROR "Required VS2022 DIA library is missing: ${_codegraph_dia}")
  endif()
  if(NOT TARGET LLVMDebugInfoPDB)
    message(FATAL_ERROR "The fixed LLVM 21.1.8 SDK must export LLVMDebugInfoPDB")
  endif()

  set(_codegraph_upstream_dia "C:/Program Files (x86)/Microsoft Visual Studio/2019/Professional/DIA SDK/lib/amd64/diaguids.lib")
  get_target_property(_codegraph_links LLVMDebugInfoPDB INTERFACE_LINK_LIBRARIES)
  set(_codegraph_updated_links)
  set(_codegraph_replacements 0)
  foreach(_codegraph_link IN LISTS _codegraph_links)
    string(REPLACE "\\" "/" _codegraph_normalized_link "${_codegraph_link}")
    if(_codegraph_normalized_link STREQUAL _codegraph_upstream_dia)
      list(APPEND _codegraph_updated_links "${_codegraph_dia}")
      math(EXPR _codegraph_replacements "${_codegraph_replacements} + 1")
    else()
      list(APPEND _codegraph_updated_links "${_codegraph_link}")
    endif()
  endforeach()
  if(NOT _codegraph_replacements EQUAL 1)
    message(FATAL_ERROR "Expected one pinned LLVM 21.1.8 DIA dependency on LLVMDebugInfoPDB; found ${_codegraph_replacements}")
  endif()
  set_property(TARGET LLVMDebugInfoPDB PROPERTY INTERFACE_LINK_LIBRARIES "${_codegraph_updated_links}")
  message(STATUS "Rebound LLVM 21.1.8 DIA dependency to ${_codegraph_dia}")
endfunction()
