{
  "name": "codegraph-build",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@11.13.1",
  "engines": {
    "node": ">=24.18.0"
  },
  "scripts": {
    "test": "node --test --test-concurrency=1 scripts/tests/*.test.mjs",
    "check:scripts": "node scripts/check-scripts.mjs",
